<%# === CHANNEL HEADER === %>
<div class="h-14 flex items-center justify-between px-5 border-b border-gray-700 bg-[#1A1D21] flex-shrink-0">
  <div class="flex items-center space-x-2">
    <h1 class="text-white text-lg font-bold"># <%= @channel.name %></h1>
  </div>
  <div class="flex items-center space-x-3">
    <%# Members indicator %>
    <div class="flex items-center text-gray-400 text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <%= turbo_stream_from @channel, "users" %>
      <span id="channel-members" class="hidden">
        <%= render @channel.users %>
      </span>
      <span><%= @channel.users.count %></span>
    </div>
    <%# Channel actions %>
      <%= link_to edit_channel_path(@channel), class: "text-gray-400 hover:text-white transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      <% end %>
    <%= button_to leave_channel_path(@channel), method: :delete, class: "text-gray-400 hover:text-red-400 transition-colors cursor-pointer", data: { turbo_confirm: "Leave ##{@channel.name}?" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
    <% end %>
  </div>
</div>

<%# === MESSAGES AREA === %>
<%= turbo_stream_from @channel, "messages" %>
<div id="chat" data-controller="chat-scroll" class="flex-1 overflow-y-auto px-5 py-4">
  <div id="messages">
    <%= render @channel.messages.order(created_at: :asc) %>
  </div>
</div>

<%# === MESSAGE INPUT === %>
<div class="flex-shrink-0 px-5 pb-6 pt-2">
  <%= form_with model: [@channel, Message.new], class: "w-full relative", data: { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" } do |f| %>
    <div class="bg-[#222529] border border-gray-600 rounded-lg focus-within:border-gray-400 transition-colors flex flex-col overflow-hidden">
      
      <%# Top Formatting Toolbar (Fake) %>
      <div class="flex items-center px-2 py-1.5 bg-[#222529] border-b border-gray-700 space-x-1">
        <button type="button" class="p-1 rounded text-gray-400 hover:bg-gray-700 transition-colors" title="Bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12h8a4 4 0 100-8H6v8zm0 0h9a4 4 0 110 8H6v-8z" /></svg>
        </button>
        <button type="button" class="p-1 rounded text-gray-400 hover:bg-gray-700 transition-colors" title="Italic">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
        </button>
        <button type="button" class="p-1 rounded text-gray-400 hover:bg-gray-700 transition-colors" title="Strikethrough">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M9 7h6m-6 10h6" /></svg>
        </button>
        <div class="w-px h-4 bg-gray-600 mx-1"></div>
        <button type="button" class="p-1 rounded text-gray-400 hover:bg-gray-700 transition-colors" title="Link">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
        </button>
        <button type="button" class="p-1 rounded text-gray-400 hover:bg-gray-700 transition-colors" title="List">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
        </button>
      </div>

      <%# Text Input %>
      <%= f.text_area :content,
          class: "flex-1 bg-transparent text-gray-100 px-3 py-2 text-sm focus:outline-none placeholder-gray-500 resize-none",
          placeholder: "Message ##{@channel.name}",
          rows: 2,
          autocomplete: "off"
        %>
        
      <%# Bottom Actions Toolbar %>
      <div class="flex items-center justify-between px-2 py-1.5 bg-[#222529]">
        <div class="flex items-center space-x-1">
          <button type="button" class="p-1.5 rounded-full bg-gray-700 text-gray-300 hover:bg-gray-600 transition-colors" title="Add attachment">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          </button>
          <div class="w-px h-4 bg-gray-600 mx-1"></div>
          <button type="button" class="p-1.5 rounded text-gray-400 hover:text-gray-200 transition-colors" title="Mention someone">
            <span class="font-bold text-sm leading-none">@</span>
          </button>
          <button type="button" class="p-1.5 rounded text-gray-400 hover:text-gray-200 transition-colors" title="Emoji">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </button>
        </div>
        
        <%= button_tag type: 'submit', class: "p-1.5 rounded bg-[#007A5A] text-white hover:bg-[#006B4F] transition-colors cursor-pointer", title: "Send" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform rotate-90" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
        <% end %>
      </div>
      
    </div>
  <% end %>
</div>