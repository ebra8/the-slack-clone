<% content_for :title, "Editing channel" %>

<div class="md:w-300 w-300 mx-auto mt-4 mb-2 p-4 bg-gray-800 rounded-lg shadow text-gray-100">
  <%= link_to "<", @channel, class: "text-center sm:mt-0 sm:ml-2 rounded-md px-3.5 py-3.5 bg-gray-800 hover:underline inline-block font-medium text-gray-100" %>


  <h1 class="font-bold text-4xl text-gray-100 inline-block">Edit channel</h1>

  <%= render "form", channel: @channel %>
  <%= button_to "Delete", @channel, method: :delete, class: "w-full sm:w-auto text-center rounded-md px-1.5 py-1.5 text-white bg-red-900 hover:bg-red-700 inline-block font-medium cursor-pointer mr-3", data: { turbo_confirm: "Are you sure?" } %>
</div>