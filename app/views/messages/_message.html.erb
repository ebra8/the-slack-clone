<% avatar_colors = ['bg-[#E01E5A]', 'bg-[#36C5F0]', 'bg-[#2EB67D]', 'bg-[#ECB22E]', 'bg-[#4A154B]', 'bg-[#1264A3]'] %>
<% user_color = avatar_colors[message.user.id % avatar_colors.length] %>

<div id="<%= dom_id(message) %>" class="flex items-start px-5 py-2 hover:bg-[#222529] transition-colors group">
  <div class="flex-shrink-0 mr-3 mt-1 cursor-pointer">
    <div class="w-9 h-9 rounded <%= user_color %> flex items-center justify-center text-white text-sm font-bold shadow-sm">
      <%= message.user.email[0].upcase %>
    </div>
  </div>
  <div class="flex flex-col min-w-0">
    <div class="flex items-baseline space-x-2">
      <span class="font-bold text-gray-100 text-[15px] hover:underline cursor-pointer tracking-tight"><%= message.user.email.split('@').first %></span>
      <span class="text-xs text-gray-400 font-medium hover:underline cursor-pointer"><%= message.created_at.strftime("%I:%M %p") %></span>
    </div>
    <div class="text-gray-300 text-[15px] leading-relaxed break-words whitespace-pre-wrap mt-0.5"><%= message.content %></div>
  </div>
</div>