<div class="flex-1 flex flex-col items-center justify-center min-h-full bg-[#1A1D21] py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-[#222529] p-10 rounded-xl shadow-2xl border border-gray-700/50">
    <div>
      <div class="mx-auto h-12 w-12 bg-gradient-to-br from-[#E01E5A] via-[#36C5F0] to-[#2EB67D] rounded-xl flex items-center justify-center shadow-lg transform rotate-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white -rotate-3" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
        </svg>
      </div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-white tracking-tight">
        Sign in to Slack Clone
      </h2>
      <p class="mt-2 text-center text-sm text-gray-400">
        We suggest using the email address you use at work.
      </p>
    </div>
    
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="space-y-1">
        <%= render "devise/shared/error_messages", resource: resource %>
      </div>

      <div class="rounded-md shadow-sm space-y-4">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "name@work-email.com", class: "appearance-none relative block w-full px-4 py-3 border border-gray-600 bg-[#1A1D21] placeholder-gray-500 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-[#1164A3] focus:border-transparent sm:text-sm transition-colors" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <%= f.label :password, class: "block text-sm font-medium text-gray-300" %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "appearance-none relative block w-full px-4 py-3 border border-gray-600 bg-[#1A1D21] placeholder-gray-500 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-[#1164A3] focus:border-transparent sm:text-sm transition-colors" %>
        </div>
      </div>

      <div class="flex items-center justify-between mt-4">
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-[#1164A3] focus:ring-[#1164A3] border-gray-600 bg-[#1A1D21] rounded" %>
            <%= f.label :remember_me, class: "ml-2 block text-sm text-gray-300 cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <div>
        <%= f.submit "Sign In", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-md text-white bg-[#007A5A] hover:bg-[#006B4F] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#007A5A] focus:ring-offset-[#222529] transition-colors cursor-pointer shadow-md" %>
      </div>
    <% end %>

    <div class="mt-6">
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-700"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-[#222529] text-gray-400">New to Slack Clone?</span>
        </div>
      </div>

      <div class="mt-6 text-center text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>